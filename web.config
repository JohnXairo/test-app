<configuration>
  <system.web>
    <compilation debug="false" targetFramework="4.5" />
    <httpRuntime targetFramework="4.5" maxRequestLength="4096" />
    <customErrors mode="Off" />
  </system.web>

  <appSettings>
    <add key="AppName" value="InstanaTestApp" />
  </appSettings>
</configuration>